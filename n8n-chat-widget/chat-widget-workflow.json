    {
      "parameters": {
        "jsCode": "const originalData = $('When chat message received').item.json;\n\nif ($json.metadata && $json.metadata.isUserInfo) {\n  return {\n    isRegistration: true,\n    cleanedMessage: '',\n    userInfo: {\n      name: $json.metadata?.userName || '',\n      email: $json.metadata?.userId || ''\n    },\n    originalData: $json\n  };\n}\n\nconst fullName = originalData.metadata?.userName || '';\nconst email    = originalData.metadata?.userId   || '';\n\nreturn {\n  isRegistration: false,\n  cleanedMessage: $json.chatInput || $json.message || '',\n  userInfo: {\n    name:  fullName,\n    email: email\n  }\n};"
      },
